# ---- LLM (OpenAI-compatible endpoint) ----
# NVIDIA free endpoint (dev) or Anthropic-compatible gateway or any OpenAI-compatible URL
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-your-key-here
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# set to 1 to enable nemotron reasoning traces (off by default for clean tool calling)
LLM_ENABLE_THINKING=0

# ---- Razorpay (test mode) ----
# Leave empty to use the built-in deterministic sandbox simulator.
# With test keys set, real test-mode Orders are created via the Razorpay API
# (visible in your dashboard); the payment capture leg is simulated locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Audit ledger ----
# Key used to HMAC-sign every ledger event. Keeping it OUT of the ledger file is
# what makes a forged event unforgeable rather than merely visible. Leave empty
# and a key is generated once into runtime/.ledger-key (gitignored). In anything
# real this comes from a KMS and is not readable by the process that writes.
LEDGER_SECRET=

# ---- Service ports ----
MANDATE_PORT=4001
STOREFRONT_PORT=4100
PANEL_PORT=3000
